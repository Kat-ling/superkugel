# Kopieren nach .env und anpassen. .env ist in .gitignore und gehört NIE ins Repo.
# --- Für die Admin-Werkzeuge (scripts/superkugel_admin.py) ---
AWS_PROFILE=superkugel-admin
AWS_REGION=eu-north-1
TABLE_NAME=superkugel
AUDIO_BUCKET=superkugel-audio-<ACCOUNT_ID>
MODE_PARAM=/superkugel/mode
# optional: E-Mail-Benachrichtigung nach Hörbuch-Import (Ausgabe "AlertTopicArn" von sam deploy)
ALERT_TOPIC_ARN=

# --- Nur für lokale Tests/Hörproben; in AWS kommt der Schlüssel aus SSM ---
OPENAI_API_KEY=

# --- Skill-Verhalten (werden in AWS über template.yaml-Parameter gesetzt) ---
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
MAX_OUTPUT_TOKENS=350
SPEECH_STYLE=kaernten
ALEXA_VOICE=Vicki
ADDRESS_FORM=du
USER_NAME=
SPEECH_RATE=100%
DAILY_COST_LIMIT_USD=0.50
MONTHLY_COST_LIMIT_USD=8.00
# v1.2: Morgengruß (true/false); Wochenbericht nutzt ALERT_TOPIC_ARN
MORNING_BRIEFING=true
